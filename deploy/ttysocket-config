#!/bin/sh
#
# /usr/local/sbin/ttysocket-config
#
# Applies the Comms page's settings to one of the terminal's bridges and
# restarts it. Called from the web UI through a narrow sudoers rule — the CGI
# runs as www-data and cannot write under /etc or drive systemd.
#
# A terminal has up to three, one config each, named after what is attached:
#
#   cardreader  /etc/ttysocket/cardreader.conf   wsrobot@cardreader   8100
#   scanner     /etc/ttysocket/scanner.conf      wsrobot@scanner      8102
#   scale       /etc/ttysocket/scale.conf        wsscale              8101
#
# Only the settings the page owns are accepted. The rest of each file — read
# mode, card-reader options, the scale's baud — is deployment-level, set when
# the terminal is built, and is preserved verbatim. A web request must not be
# able to switch a scanner into card-decoding mode.
#
# Usage: ttysocket-config <service> <port> <local|foreign> <format> <TRUE|FALSE>
#                         [tty] [scale model]
#
# For the scale, <format> is ignored: wsScale sends structured readings, not a
# formatted line. The tty argument is optional; empty keeps what the terminal
# has. The scale model is only meaningful for the scale, and only on a terminal
# with no server - when the SCADA server's setup names a scale, that wins.
#
# (C) 2017-2026, Radical Electronic Systems - www.radicalsystems.co.za

set -e

SERVICE="$1"
PORT="$2"
HOST="$3"
FORMAT="$4"
ENABLED="$5"
TTY_NEW="$6"
MODEL="$7"

die() { echo "$1" >&2; exit 1; }

# Validate before writing: this input arrives from a web request, and a phone
# on the setup hotspot reaches these endpoints without a password.
case "$SERVICE" in
    cardreader) CONF=/etc/ttysocket/cardreader.conf; UNIT=wsrobot@cardreader ;;
    scanner)    CONF=/etc/ttysocket/scanner.conf;    UNIT=wsrobot@scanner ;;
    scale)      CONF=/etc/ttysocket/scale.conf;      UNIT=wsscale ;;
    *) die "unknown service: $SERVICE" ;;
esac

case "$PORT" in
    ''|*[!0-9]*) die "port must be numeric" ;;
esac
[ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || die "port out of range"

case "$HOST" in
    local|foreign) ;;
    *) die "host must be local or foreign" ;;
esac

case "$FORMAT" in
    *[!-A-Za-z0-9%:_.\[\]\ ]*) die "format has unexpected characters" ;;
esac
[ -n "$FORMAT" ] || FORMAT="%s"

case "$ENABLED" in
    TRUE|FALSE) ;;
    *) die "enabled must be TRUE or FALSE" ;;
esac

# --- which port the reader is on -----------------------------------
# This used to be deployment-level and unchangeable from the web, on the
# reasoning that a web request must not be able to repoint the bridge. That
# holds for an arbitrary port. It does not hold for a terminal whose reader can
# legitimately be on any free USB socket: a scanner or a USB-to-serial hub goes
# into whichever port was open and comes up as ttyACM0 or ttyACM1 depending on
# nothing anyone controls. Refusing the choice there leaves the terminal wrong
# until somebody with a shell fixes it.
#
# So a port may be sent, and it is checked here rather than trusted.
# /etc/robot/serialports.conf is the device's own account of where hardware can
# be; the web UI reads it to build the list, and this reads it again to check
# what came back. The list is the convenience, this is the rule - a phone on
# the setup hotspot reaches those pages without a password.
#
# The list is per service, because they are not interchangeable: the card
# reader is soldered to ttyS0 and its list says so, while the scanner and the
# scale arrive on whichever USB socket was free.
for FILTERFILE in /etc/robot/serialports.conf /etc/formfactor/serialports.conf; do
    [ -r "$FILTERFILE" ] && { . "$FILTERFILE"; break; }
done

case "$SERVICE" in
    cardreader) PORTS_ALLOW="${SERIAL_PORTS_CARDREADER:-}" ;;
    scanner)    PORTS_ALLOW="${SERIAL_PORTS_SCANNER:-}" ;;
    scale)      PORTS_ALLOW="${SERIAL_PORTS_SCALE:-}" ;;
esac
[ -n "$PORTS_ALLOW" ] || PORTS_ALLOW="${SERIAL_PORTS_ALLOW:-ttyACM* ttyUSB*}"

# The name to write down for a port. /dev/ttyACM0 is not a name: the number is
# handed out in the order devices appear, so a scanner unplugged and plugged
# back in comes back as ttyACM1 and the bridge opens a port that is no longer
# there. /dev/serial/by-id carries the device's own serial number and follows
# it, so it is preferred whenever the kernel offers one.
#
# The page speaks node names, because that is what someone reading the terminal
# sees. This is where that turns into something durable.
stable_name() {
    s_name="$1"
    for s_link in /dev/serial/by-id/*; do
        [ -e "$s_link" ] || continue
        if [ "$(readlink -f "$s_link" 2>/dev/null)" = "/dev/$s_name" ]; then
            echo "$s_link"
            return
        fi
    done
    echo "/dev/$s_name"
}

validate_tty() {
    v_name=${1#/dev/}

    case "$v_name" in
        ''|*/*|.*) die "not a serial port name: $1" ;;
    esac

    # Present, and a character device. A name that matches the list but is not
    # there is a reader that was unplugged between the page loading and the
    # save - worth refusing, because the alternative is a service that starts
    # and never reads anything.
    [ -c "/dev/$v_name" ] || die "$v_name is not present on this terminal"

    for v_deny in ${SERIAL_PORTS_DENY:-}; do
        case "$v_name" in $v_deny) die "$v_name is not available on this terminal" ;; esac
    done

    for v_pattern in $PORTS_ALLOW; do
        case "$v_name" in
            $v_pattern) stable_name "$v_name"; return ;;
        esac
    done

    die "$v_name is not a port this terminal offers for the $SERVICE"
}

# Keep the deployment-level settings. The values written below are quoted,
# because /usr/local/lib/ttysocket/launch.sh sources this file under `set -e`:
# an unquoted "-c SHORT" makes the shell run SHORT as a command, and the bridge
# exits 127 without ever opening the port.
mkdir -p /etc/ttysocket

if [ "$SERVICE" = "scale" ]; then
    TTYSCALE_TTY=/dev/ttyUSB0
    TTYSCALE_BAUD=9600
    TTYSCALE_SETUP=""
    TTYSCALE_MODEL=""
    [ -r "$CONF" ] && . "$CONF"
    [ -n "$TTY_NEW" ] && TTYSCALE_TTY=$(validate_tty "$TTY_NEW")

    # The model is checked against what this build can actually decode, not
    # taken on trust: an unknown protocol makes wsScale exit at startup, so an
    # unchecked value here is a scale that stops working at the next restart
    # with the reason only in the journal.
    if [ -n "$MODEL" ]; then
        if /usr/local/bin/wsScale -l 2>/dev/null | grep -qx -- "$MODEL"; then
            TTYSCALE_MODEL="$MODEL"
        else
            die "unknown scale protocol: $MODEL"
        fi
    fi

    {
        echo "# Written by the web UI. See /usr/share/doc/wsscale/scale.conf for"
        echo "# every key and its default."
        echo "TTYSCALE_PORT=${PORT}"
        echo "TTYSCALE_TTY=${TTYSCALE_TTY}"
        echo "TTYSCALE_BAUD=${TTYSCALE_BAUD}"
        echo "TTYSCALE_HOST=${HOST}"
        # Which scale this is, for a terminal with no server to ask. When the
        # server's setup names one, wsScale reads it after this file and the
        # server wins - so this is a fallback, not an override.
        [ -n "$TTYSCALE_MODEL" ] && echo "TTYSCALE_MODEL=${TTYSCALE_MODEL}"
        # Which file carries the scale's model, units and limits. Not a page
        # setting - the server owns those - but it has to survive a save, or
        # wsScale comes back with "No scale configured".
        [ -n "$TTYSCALE_SETUP" ] && echo "TTYSCALE_SETUP=${TTYSCALE_SETUP}"
    } > "$CONF"
else
    # A scanner streams whatever it reads; a card reader decodes RDM6300
    # packets and repeats while the card is held. These are the defaults for a
    # file that does not exist yet - an existing one keeps its own.
    if [ "$SERVICE" = "scanner" ]; then
        TTYSOCKET_TTY=""
        TTYSOCKET_MODE=raw
        TTYSOCKET_OPTS=""
        TTYSOCKET_REPEAT=0
    else
        TTYSOCKET_TTY=/dev/ttyS0
        TTYSOCKET_MODE=rdm6300
        TTYSOCKET_OPTS="-c SHORT"
        TTYSOCKET_REPEAT=0
    fi
    TTYSOCKET_BAUD=9600
    [ -r "$CONF" ] && . "$CONF"

    # Sent values win over what was there; empty keeps it.
    if [ -n "$TTY_NEW" ]; then
        TTYSOCKET_TTY=$(validate_tty "$TTY_NEW")
    fi
    [ -n "$TTYSOCKET_TTY" ] || die "no serial port set for the $SERVICE"

    cat > "$CONF" <<CONFEOF
# Written by the web UI. See /usr/share/doc/wsrobot/${SERVICE}.conf for every
# key and its default.
TTYSOCKET_PORT=${PORT}
TTYSOCKET_TTY=${TTYSOCKET_TTY}
TTYSOCKET_BAUD=${TTYSOCKET_BAUD}
TTYSOCKET_HOST=${HOST}
TTYSOCKET_FORMAT="${FORMAT}"
TTYSOCKET_MODE=${TTYSOCKET_MODE}
TTYSOCKET_OPTS="${TTYSOCKET_OPTS}"
TTYSOCKET_REPEAT=${TTYSOCKET_REPEAT}
CONFEOF
fi
chmod 644 "$CONF"

# systemd owns whether this starts on boot, and the page reads it back from
# systemd — so both halves have to actually happen. `|| true` on the enable was
# how a terminal ended up running a disabled service: the save reported success,
# the restart took effect, and the unit came back after a reboot switched off.
#
# --now pairs the boot setting with the running state in one step, so the two
# cannot be left disagreeing.
if [ "$ENABLED" = "TRUE" ]; then
    systemctl enable "$UNIT"
    systemctl restart "$UNIT"
else
    systemctl disable --now "$UNIT"
fi
